{
  "sources": [
    {
      "name": "Guovin_IPTV",
      "url": "https://raw.githubusercontent.com/Guovin/iptv-api/gd/output/result.m3u",
      "format": "m3u"
    },
    {
      "name": "YueChan_Live",
      "url": "https://raw.githubusercontent.com/YueChan/Live/main/IPTV.m3u",
      "format": "m3u"
    },
    {
      "name": "fanmingming_ipv6",
      "url": "https://live.fanmingming.com/tv/m3u/ipv6.m3u",
      "format": "m3u"
    },
    {
      "name": "zbds_ipv6",
      "url": "https://live.zbds.top/tv/iptv6.m3u",
      "format": "m3u"
    },
    {
      "name": "Ftindy_IPTV",
      "url": "https://raw.githubusercontent.com/Ftindy/IPTV-URL/main/IPTV.m3u",
      "format": "m3u"
    },
    {
      "name": "ssili126_itv",
      "url": "https://raw.githubusercontent.com/ssili126/tv/main/itvlist.m3u",
      "format": "m3u"
    }
  ],
  "checker": {
    "timeout": 3.0,
    "concurrency": 25,
    "max_retries": 1,
    "user_agent": "okhttp/3.15 XiaoWeiLive/5.0.0"
  },
  "channel_groups": [
    {
      "name": "央视频道",
      "patterns": [
        "^CCTV-\\d+(\\+)?$",
        "^CCTV-4K$",
        "^CCTV-8K$",
        "^CCTV-5\\+$",
        "^CGTN.*"
      ]
    },
    {
      "name": "卫视频道",
      "patterns": [
        ".*卫视$"
      ]
    },
    {
      "name": "电影频道",
      "patterns": [
        ".*电影.*",
        "^CHC.*",
        ".*影院.*",
        ".*剧场.*"
      ]
    },
    {
      "name": "体育频道",
      "patterns": [
        ".*体育.*",
        ".*赛事.*",
        ".*足球.*",
        ".*五星体育.*"
      ]
    },
    {
      "name": "动画少儿",
      "patterns": [
        ".*少儿.*",
        ".*卡通.*",
        ".*动画.*",
        ".*炫动.*"
      ]
    },
    {
      "name": "港·澳·台",
      "patterns": [
        ".*凤凰.*",
        "^TVB.*",
        ".*翡翠.*",
        ".*澳亚.*",
        ".*莲花.*"
      ]
    },
    {
      "name": "地方频道",
      "patterns": [
        ".*综合.*",
        ".*都市.*",
        ".*影视.*",
        ".*新闻.*"
      ]
    }
  ],
  "ad_keywords": [
    "购物",
    "特惠",
    "商城",
    "导购",
    "测试",
    "广告",
    "体验",
    "专享",
    "专卖",
    "优惠",
    "热卖",
    "理财",
    "彩票",
    "聚鲨"
  ],
  "output": {
    "dir": "output",
    "xiaowei_txt": "live_xiaowei.txt",
    "standard_m3u": "live.m3u",
    "max_lines_per_channel": 3
  },
  "min_valid_channels": 1,
  "auto_refresh_hours": 12
}
